<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scoped to this repo: clears inherited sources (including the internal
       Artifactory feed in %APPDATA%\NuGet\NuGet.Config) so restore works off-network. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
